# 允许 esbuild / vue-demi 执行 postinstall。
# 不加这一条时 pnpm 11 会以 [ERR_PNPM_IGNORED_BUILDS] 让 install 退出码为 1，
# 依赖链接因此中断 → vite 启动时报 "Cannot find package 'esbuild'"。
# package.json 里的 pnpm.onlyBuiltDependencies 与 pnpm-workspace.yaml 在当前 pnpm 版本均未生效，
# 故在此显式放开（sharp 仅为 puppeteer-core 的传递依赖，本地开发构建脚本无副作用）。
dangerously-allow-all-builds=true
