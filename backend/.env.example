# go-auth-admin 后端配置模板
# 用法：cp .env.example .env（.env 已被 .gitignore 忽略，不会被提交）
# 所有项都可省略 —— 省略即回退到下面注释里的默认值，默认值与 java-vue-admin 的
# application.yml 保持一致，因此前端可零改动桥接。

# ---------- 服务 ----------
# 前端 vite proxy 目标是 http://localhost:8080，改端口需同步改前端 vite.config.ts
SERVER_PORT=8080

# ---------- 数据库 ----------
# SQLite 单文件库路径；目录不存在时自动创建
DB_URL=./data/vue-admin.db

# SQLite 是单写者模型，连接数必须限制，否则并发写直接 "database is locked"。
# 一般保持默认即可；只有读多写少且确认 WAL 生效时才调大 DB_MAX_OPEN_CONNS。
DB_MAX_OPEN_CONNS=4
DB_MAX_IDLE_CONNS=2
# 写锁等待毫秒数（0 = 不等待，立即报 SQLITE_BUSY）
DB_BUSY_TIMEOUT_MS=5000

# ---------- JWT ----------
# 生产环境务必替换！生成方式：openssl rand -base64 32
# 改了它，已签发的 token 全部失效（需重新登录）。
# 默认值与 Java application.yml 相同，仅用于本地开发。
JWT_SECRET=Y2hhbmdlLW1lLXBsZWFzZS11c2Utb3BlbnNzbC1yYW5kLWJhc2U2NC0zMg==

# 与 Java 一致：access 60 分钟 / refresh 7 天
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ISSUER=vue-admin

# 请求头格式：Authorization: Bearer <token>
# 改这两项会导致前端 request.ts 拦截器取不到 token，除非同步改前端。
JWT_HEADER=Authorization
JWT_PREFIX=Bearer

# ---------- CORS ----------
# 开发环境用 *；生产请改为具体前端 origin（逗号分隔）
CORS_ORIGINS=*
